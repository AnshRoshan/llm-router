{
  "name": "llmrouter",
  "version": "0.2.0",
  "description": "Cache-aware LLM routing for Node.js: picks the (model, backend) pair, keeps sessions sticky, and chooses prompt-cache TTL per breakpoint. Zero dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "llmrouter": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "build:demo": "esbuild src/demo.ts --bundle --minify --format=iife --global-name=LLMRouterDemo --outfile=../../website/assets/llmrouter-demo.js"
  },
  "keywords": [
    "llm",
    "router",
    "prompt-caching",
    "kv-cache",
    "cost-optimization",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnshRoshan/llm-router.git",
    "directory": "npm/llmrouter"
  },
  "homepage": "https://anshroshan.github.io/llm-router/",
  "bugs": {
    "url": "https://github.com/AnshRoshan/llm-router/issues"
  },
  "author": "llmrouter contributors",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0"
  }
}
